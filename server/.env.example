NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/studyrag
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Hosted AI for chat, quiz, and flashcard generation. Keep the API key on the server only.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional transactional email for verification and password recovery. Configure all required values together.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Document binaries stay on the server in development. Set S3 for deployment (R2 works too).
STORAGE_PROVIDER=local
# DOCUMENT_STORAGE_DIR=C:\\studyrag-private-storage
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=studyrag-private-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
