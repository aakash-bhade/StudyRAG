NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/studyrag
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Hosted AI for chat, quiz, and flashcard generation. Keep the API key on the server only.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional local Ollama chat provider. Set AI_PROVIDER=ollama to use it instead.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# Optional semantic search. Use an Ollama embedding model, e.g. embeddinggemma.
OLLAMA_EMBEDDING_MODEL=
# Optional transactional email for verification and password recovery. Configure all required values together.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional local development override; production must use persistent private object storage.
# DOCUMENT_STORAGE_DIR=C:\\studyrag-private-storage
